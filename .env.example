# PostgreSQL connection string for local development.
DATABASE_URL=postgresql://nama:nama_local_password@127.0.0.1:5432/nama

# PostgreSQL container settings used by docker compose. Use unique, local-only values.
POSTGRES_DB=nama
POSTGRES_USER=nama
POSTGRES_PASSWORD=nama_local_password
POSTGRES_PORT=5432

# Used to encrypt JWT tokens
PAYLOAD_SECRET=replace-with-a-long-random-local-secret

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=replace-with-a-long-random-local-cron-secret

# Used to validate preview requests
PREVIEW_SECRET=replace-with-a-long-random-local-preview-secret

# Production values belong in the hosting provider's Secret Manager or environment settings.
# Do not commit production passwords, connection strings, or secrets.
